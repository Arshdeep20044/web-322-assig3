<!DOCTYPE html>
<html>
<head>
  <title>Your Tasks</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>

<h2>Your Tasks</h2>
<a href="/tasks/add">Add New Task</a> | <a href="/dashboard">Dashboard</a>

<table>
  <tr>
    <th>Title</th>
    <th>Due</th>
    <th>Status</th>
    <th>Actions</th>
  </tr>

  <% tasks.forEach(task => { %>
  <tr>
    <td><%= task.title %></td>
    <td><%= task.dueDate %></td>
    <td><%= task.status %></td>
    <td>
      <a href="/tasks/edit/<%= task.id %>">Edit</a>

      <form method="POST" action="/tasks/delete/<%= task.id %>" style="display:inline;">
        <button type="submit">Delete</button>
      </form>
    </td>
  </tr>
  <% }) %>
</table>

</body>
</html>
